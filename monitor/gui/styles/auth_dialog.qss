/* Authentication Dialog Styles */

#auth-dialog {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-family: "Segoe UI", "DejaVu Sans", "Liberation Sans", "Noto Sans", Arial, 
    sans-serif;
    min-width: 400px;
    min-height: 200px;
}

#auth-description {
    font-size: 14px;
    line-height: 1.4;
    font-family: "Segoe UI", "DejaVu Sans", "Liberation Sans", "Noto Sans", Arial, sans-serif;
}

#auth-password-input {
    padding: 6px 12px;
    border: 2px solid #ced4da;
    border-radius: 4px;
    font-size: 14px;
    background-color: white;
    min-height: 20px;
    font-family: "Segoe UI", "DejaVu Sans", "Liberation Sans", "Noto Sans", Arial, sans-serif;
}

#auth-password-input:hover {
    border-color: #adb5bd;
}

#auth-ok-button {
    background-color: #0d6efd;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "DejaVu Sans", "Liberation Sans", "Noto Sans", Arial, sans-serif;
}

#auth-ok-button:hover {
    background-color: #0b5ed7;
}

#auth-ok-button:pressed {
    background-color: #0a58ca;
}

#auth-cancel-button {
    background-color: #6c757d;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "DejaVu Sans", "Liberation Sans", "Noto Sans", Arial, sans-serif;
}

#auth-cancel-button:hover {
    background-color: #5c636a;
}

#auth-cancel-button:pressed {
    background-color: #565e64;
}
