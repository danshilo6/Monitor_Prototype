/* Navigation Bar Styles - Qt Compatible */
NavigationBar {
    background-color: #2d3142;
    border-right: 1px solid #4f5b66;
    min-width: 150px;
}

/* Navigation Button Styles */
NavigationBar QPushButton {
    background-color: rgba(72, 88, 124, 1);
    color: white;
    border: none;
    padding: 12px 12px;
    margin: 2px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
    min-width: 60px;
    min-height: 15px;
    icon-size: 20px 20px;
}

NavigationBar QPushButton:hover {
    background-color: rgba(100, 121, 170, 1);
}

NavigationBar QPushButton:checked {
    background-color: rgba(195, 66, 90, 1);
}

NavigationBar QPushButton:checked:hover {
    background-color: rgba(195, 66, 90, 1);
}

/* Icon styling for different states */
NavigationBar QPushButton::icon {
    padding-left: 8px;
}
