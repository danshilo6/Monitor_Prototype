/* Alerts List Styles */

/* Page Header */
QLabel#page-header {
    font-size: 24px;
    font-weight: bold;
    color: #2d3142;
    margin: 2px 0px;
    padding: 2px;
    background-color: #f8f9fa;
}


AlertsList {
    background-color: transparent;
    border: none;
    padding: 0px;
}

/* QTableWidget and QTableView Styles */
AlertsList QTableWidget, QTableView#alertsTable {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    gridline-color: #f0f0f0;
    selection-background-color: transparent;
    alternate-background-color: #f8f9fa;
}

AlertsList QTableWidget::item, QTableView#alertsTable::item {
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #f0f0f0;
}

/* Icon sizing for the type column */
QTableView#alertsTable::item:first-child {
    padding: 8px;
}

QTableView#alertsTable QAbstractItemView::item {
    icon-size: 20px 20px;
}

/* Remove selection highlighting */
AlertsList QTableWidget::item:selected, QTableView#alertsTable::item:selected {
    background-color: transparent;
    color: #2d3142;
}

AlertsList QTableWidget::item:focus, QTableView#alertsTable::item:focus {
    background-color: transparent;
    outline: none;
}

/* Header styling */

AlertsList QHeaderView::section, QTableView#alertsTable QHeaderView::section {
    background-color: #f8f9fa;
    padding: 4px 8px;
    border: none;
    border-bottom: 2px solid #e0e0e0;
    font-weight: bold;
    color: #2d3142;
    font-size: 14px;
}


AlertsList QHeaderView::section:last, QTableView#alertsTable QHeaderView::section:last {
    /* No right border needed, already removed above */
}

AlertsList QScrollArea, QTableView#alertsTable QScrollArea {
    border: none;
    background-color: transparent;
}

AlertsList QScrollArea > QWidget > QWidget {
    background-color: #ffffff;
}

AlertsList QScrollBar:vertical, QTableView#alertsTable QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 8px;
    border-radius: 4px;
}

AlertsList QScrollBar::handle:vertical, QTableView#alertsTable QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-height: 20px;
}

AlertsList QScrollBar::handle:vertical:hover, QTableView#alertsTable QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

AlertsList QScrollBar::add-line:vertical, QTableView#alertsTable QScrollBar::add-line:vertical,
AlertsList QScrollBar::sub-line:vertical, QTableView#alertsTable QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Icon-based Remove Button for Table */

QPushButton#removeTableBtn {
    border: none;
    background: transparent;
    qproperty-icon: url("monitor/gui/icons/trashcan.svg");
    qproperty-iconSize: 18px 18px;
}

QPushButton#removeTableBtn:hover {
    background: transparent;
    border: none;
    qproperty-icon: url("monitor/gui/icons/trashcan_hover.svg");
}

QPushButton#removeTableBtn:pressed {
    background: transparent;
    border: none;
}

QPushButton#removeTableBtn:focus {
    outline: none;
    border: none;
}
